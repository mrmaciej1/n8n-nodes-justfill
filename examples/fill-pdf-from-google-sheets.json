        0
      ],
      "id": "982ffb86-d0af-4350-99c8-e9f5875342cf",
      "name": "Get rows"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nif (!/^https?:\\/\\//.test(cfg.pdfUrl || '')) throw new Error('Set pdfUrl in Config to a public link to your blank PDF.');\n// Built here, not inline, so n8n's expression parser never sees `}}` in an object literal.\nreturn [{ json: { openBody: { jsonrpc: '2.0', id: 1, method: 'tools/call', params: { name: 'open_pdf', arguments: { url: cfg.pdfUrl } } } } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "id": "c4722c71-908b-4e50-a81c-a5e891ab2134",
      "name": "Build open request",
      "executeOnce": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://justfill.app/api/mcp",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').item.json.apiKey }}"
            },
            {
              "name": "Accept",
              "value": "application/json, text/event-stream"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.openBody) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "id": "149c9c06-0a3e-498c-b2fb-44de6b6e4030",
      "name": "Open PDF"
    },
    {
      "parameters": {
        "jsCode": "const rpc = $input.first().json;\nif (rpc.error) throw new Error('MCP transport error: ' + JSON.stringify(rpc.error));\nif (rpc.result && rpc.result.isError) throw new Error('MCP tool error: ' + ((rpc.result.content && rpc.result.content[0] && rpc.result.content[0].text) || 'unknown'));\nconst ws = JSON.parse(rpc.result.content[0].text);\nif (ws.error) throw new Error('open_pdf: ' + ws.error);\nconst source = ws.summary && ws.summary.source;\nif (!['template', 'acroform'].includes(source)) {\n  throw new Error('This PDF has no saved JustFill template yet (source: ' + source + '). Open it once at justfill.app, check the fields, give them names that match your column headers and save it as a template. Then run this workflow again.');\n}\nconst cfg = $('Config').first().json;\nconst norm = s => String(s ?? '').normalize('NFC').toLowerCase().replace(/[^\\p{L}\\p{M}\\p{N}]+/gu, '');\nconst byName = new Map();\nfor (const f of ws.fields) { const k = norm(f.name); if (k) byName.set(k, byName.has(k) ? null : f); }\nconst skip = new Set([norm('row_number'), norm(cfg.linkColumn)]);\nconst out = [], unmatched = new Set();\nfor (const row of $('Get rows').all()) {\n  const r = row.json, values = {};\n  for (const [col, v] of Object.entries(r)) {\n    const k = norm(col);\n    if (!k || skip.has(k)) continue;\n    const f = byName.get(k);\n    if (f === null) throw new Error('Two PDF fields share the name for column ' + col + '. Give each field a unique name.');\n    if (!f) { unmatched.add(col); continue; }\n    if (v !== '' && v !== null && v !== undefined) values[f.id] = String(v);\n  }\n  if (!Object.keys(values).length) continue;\n  const base = String(r[cfg.fileNameColumn] ?? ('row-' + r.row_number)).replace(/[\\\\/:*?\"<>|]+/g, ' ').trim() || ('row-' + r.row_number);\n  out.push({ json: {\n    row_number: r.row_number,\n    fileName: base + '.pdf',\n    matched: Object.keys(values).length,\n    unmatchedColumns: [...unmatched],\n    fillBody: { jsonrpc: '2.0', id: 2, method: 'tools/call', params: { name: 'fill_pdf', arguments: { workspace_id: ws.summary.workspace_id, values } } },\n  } });\n}\nif (!out.length) throw new Error('No row had a value in a column that matches a PDF field name.');\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "id": "ae69e71a-6927-4ba1-833d-c2db44636910",
      "name": "Match columns to fields"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1320,
        0
      ],
      "id": "167ec258-1d60-4242-94c7-2a7340c52f73",
      "name": "Loop Over Items"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://justfill.app/api/mcp",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').item.json.apiKey }}"
            },
            {
              "name": "Accept",
              "value": "application/json, text/event-stream"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.fillBody) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        120
      ],
      "id": "4edf35c2-baba-40ec-a43b-fdce11a6d6e9",
      "name": "Fill PDF"
    },
    {
      "parameters": {
        "jsCode": "const rpc = $input.first().json;\nif (rpc.error) throw new Error('MCP transport error: ' + JSON.stringify(rpc.error));\nif (rpc.result && rpc.result.isError) throw new Error('MCP tool error: ' + ((rpc.result.content && rpc.result.content[0] && rpc.result.content[0].text) || 'unknown'));\nconst res = JSON.parse(rpc.result.content[0].text);\nif (res.error) throw new Error('fill_pdf: ' + res.error);\nconst row = $('Loop Over Items').first().json;\n// Each fill replaces the previous download link, so the next node downloads it right away.\nreturn [{ json: { row_number: row.row_number, fileName: row.fileName, download_url: res.download_url, output_mode: res.output_mode, warnings: res.warnings || null } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        120
      ],
      "id": "d91a7f2d-3ba3-42e0-b1b5-938e78a4bd34",
      "name": "Read fill result"
    },
    {
      "parameters": {
        "url": "={{ $json.download_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        120
