{
  "name": "Fill one PDF per Google Sheets row with JustFill",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "id": "fa3ed6bd-97a3-417a-87a2-161eeb8ec099",
      "name": "Run for every row"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "73a9d32b-f84c-47d9-9c37-e7ecf0ef5874",
              "name": "apiKey",
              "value": "jf_live_YOUR_API_KEY_HERE",
              "type": "string"
            },
            {
              "id": "97af9a61-9fd9-4fa7-badc-aa87da0c052f",
              "name": "pdfUrl",
              "value": "https://example.com/your-blank-form.pdf",
              "type": "string"
            },
            {
              "id": "d80d29df-c756-4274-a4ff-640d0f887910",
              "name": "fileNameColumn",
              "value": "Name",
              "type": "string"
            },
            {
              "id": "c7e2477a-a197-4941-b655-387405b2cf0b",
              "name": "linkColumn",
              "value": "PDF link",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "id": "577f6e4a-8394-4d95-b95c-ac54efbea1f1",
      "name": "Config"
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "sheetName": {
          "__rl": true,
          "value": "gid=0",
          "mode": "list",
          "cachedResultName": "Sheet1"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
